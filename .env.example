# Neon PostgreSQL connection strings
# Pooled - usado en runtime/serverless
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/lucia_jeans?sslmode=require"
# Unpooled (direct) - usado por prisma migrate/db push/seed
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxx.region.aws.neon.tech/lucia_jeans?sslmode=require"

# Public site URL (used for share links / SEO)
NEXT_PUBLIC_SITE_URL="https://lucia-jeans.vercel.app"

# Brand / contact
NEXT_PUBLIC_WHATSAPP_NUMBER="51999999999"
NEXT_PUBLIC_INSTAGRAM_URL="https://instagram.com/luciajeans"
NEXT_PUBLIC_FACEBOOK_URL="https://facebook.com/luciajeans"
NEXT_PUBLIC_TIKTOK_URL="https://tiktok.com/@luciajeans"

# Auth (JWT signing secret) - generate with: openssl rand -hex 32
JWT_SECRET="change-me-with-a-very-long-random-string-min-32-chars"
JWT_EXPIRES_IN="7d"

# Admin seed credentials (used by `pnpm db:seed`)
ADMIN_EMAIL="admin@luciajeans.com"
ADMIN_PASSWORD="Lucia#2026"

# Cloudinary (image uploads)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
